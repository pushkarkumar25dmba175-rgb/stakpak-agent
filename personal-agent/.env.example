# PersonalOS Agent — development environment.
# Copy to .env and fill in what you need. Never commit the filled-in copy.
#
# Nothing here is required to run the agent: with no key configured it plans
# from keywords instead of a model, and every other feature still works.

# ---- which model to use ----------------------------------------------------
# anthropic | openai | ollama | echo
PERSONALOS_LLM_PROVIDER=anthropic
PERSONALOS_LLM_MODEL=claude-opus-5

# The key itself is read from the variable named by llm.api_key_env in
# config.yaml (ANTHROPIC_API_KEY by default). Set that variable here.
ANTHROPIC_API_KEY=

# For OpenAI or any OpenAI-compatible endpoint:
# PERSONALOS_LLM_PROVIDER=openai
# PERSONALOS_LLM_MODEL=gpt-4o
# OPENAI_API_KEY=
# PERSONALOS_LLM_BASE_URL=https://api.openai.com/v1

# For a fully local setup — no request ever leaves this machine:
# PERSONALOS_LLM_PROVIDER=ollama
# PERSONALOS_LLM_MODEL=llama3.1
# PERSONALOS_LLM_BASE_URL=http://127.0.0.1:11434

# ---- where the agent keeps its state ---------------------------------------
# PERSONALOS_HOME=~/.personalos

# ---- behaviour -------------------------------------------------------------
# strict | normal | relaxed. `strict` confirms everything above read-only.
PERSONALOS_APPROVAL_MODE=normal
PERSONALOS_SHELL_ENABLED=true
PERSONALOS_LEARNING_ENABLED=true
# PERSONALOS_ACTIVE_PROJECT=threat-research
# PERSONALOS_DASHBOARD_PORT=8765
