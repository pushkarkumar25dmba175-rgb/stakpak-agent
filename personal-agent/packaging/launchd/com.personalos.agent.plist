<?xml version="1.0" encoding="UTF-8"?>
<!--
  Install to ~/Library/LaunchAgents/com.personalos.agent.plist, then:
    launchctl load ~/Library/LaunchAgents/com.personalos.agent.plist

  Replace YOUR_USERNAME below. This is a LaunchAgent, not a LaunchDaemon:
  it runs as you, in your session, with no elevated privileges.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.personalos.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/.local/bin/agent</string>
        <string>schedule</string>
        <string>serve</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PERSONALOS_HOME</key>
        <string>/Users/YOUR_USERNAME/.personalos</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/.personalos/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/.personalos/logs/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
